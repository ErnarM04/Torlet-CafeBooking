# Copy: cp .env.example .env

# Production (Fly): set via `fly secrets set -a torletbackend DEBUG=False`
# DEBUG=True
# ALLOWED_HOSTS=torletbackend.fly.dev,localhost
# CORS_ALLOWED_ORIGINS=https://torlet.fly.dev,https://your-custom-domain.com

# AI (https://console.groq.com/keys)
GROQ_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.1-8b-instant

# PostgreSQL (local Docker)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
POSTGRES_DB=diploma_cafe_booking
POSTGRES_USER=cafe_app
POSTGRES_PASSWORD=change-me
